@page
@model IndexModel
@{
    ViewData["Title"] = "Reservation Management";
}

<!-- Baner główny -->
<div class="hotel-hero">
    <!-- Widget pogodowy -->
    <div class="weather-widget-glass d-none" id="weather-widget" title="Local Weather in Krosno">
        <span class="weather-icon" id="weather-icon">☀️</span>
        <span class="weather-temp" id="weather-temp">--°C</span>
        <span class="weather-desc" id="weather-desc">Loading...</span>
    </div>
    <div class="hotel-hero-overlay"></div>
    <div class="hotel-hero-content">
        <h1>Boutique Luxury at <em>Grand Hotel</em></h1>
        <p>Immerse yourself in warm minimalism and refined comfort. Experience an unforgettable stay tailored to your every detail.</p>
        <button class="btn-luxury-lg" onclick="showAddReservationModal()">Book Your Stay</button>
    </div>
</div>

<!-- Formularze logowania / rejestracji -->
<div class="card-hotel auth-card glass-auth-card">
    <!-- Widok logowania -->
    <div id="auth-logged-out-panel">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Username</label>
                <input type="text" class="form-control" id="auth-username" placeholder="Enter username">
            </div>
            <div class="col-md-3">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" id="auth-password" placeholder="Enter password">
            </div>
            <div class="col-md-2">
                <button class="btn-gold w-100" onclick="login()">Sign In</button>
            </div>
            <div class="col-md-4 text-md-end" style="display:flex;gap:.35rem;flex-wrap:wrap;justify-content:flex-end;align-items:center">
                <button class="demo-btn" onclick="fillDemoLogin('admin')">Admin</button>
                <button class="demo-btn" onclick="fillDemoLogin('reception')">Receptionist</button>
                <button class="demo-btn" onclick="fillDemoLogin('client')">Client</button>
                <a href="#" onclick="showRegisterPanel(event)" class="auth-toggle-link" style="font-size:0.85rem;color:var(--gold);text-decoration:none;font-weight:600;margin-left:0.5rem">Register</a>
            </div>
        </div>
    </div>

    <!-- Widok rejestracji -->
    <div id="auth-register-panel" class="d-none">
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Username</label>
                <input type="text" class="form-control" id="reg-username" placeholder="Unique login">
            </div>
            <div class="col-md-2">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" id="reg-password" placeholder="Password">
            </div>
            <div class="col-md-2">
                <label class="form-label">First Name</label>
                <input type="text" class="form-control" id="reg-firstname" placeholder="Name">
            </div>
            <div class="col-md-2">
                <label class="form-label">Last Name</label>
                <input type="text" class="form-control" id="reg-lastname" placeholder="Surname">
            </div>
            <div class="col-md-2">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" id="reg-email" placeholder="Email address">
            </div>
            <div class="col-md-1">
                <label class="form-label">Phone</label>
                <input type="text" class="form-control" id="reg-phone" placeholder="Phone">
            </div>
            <div class="col-md-1 text-end" style="display:flex;flex-direction:column;gap:0.35rem">
                <button class="btn-gold w-100" onclick="register()">Sign Up</button>
                <a href="#" onclick="showLoginPanel(event)" class="auth-toggle-link" style="font-size:0.75rem;color:var(--text-light);text-decoration:none;text-align:center;font-weight:500">Sign In</a>
            </div>
        </div>
    </div>

    <div class="d-none" id="auth-logged-in-panel">
        <div class="d-flex justify-content-between align-items-center flex-wrap" style="gap:.75rem">
            <div style="display:flex;align-items:center;gap:.75rem">
                <span class="user-pill" id="auth-username-display">—</span>
                <span class="role-pill" id="auth-role-display">—</span>
            </div>
            <button class="btn-danger-sm" onclick="logout()">Sign Out</button>
        </div>
    </div>

    <div class="mt-2" id="auth-message"></div>
</div>

<!-- Zakładki (nawigacja SPA) -->
<div class="nav-tab-container" id="nav-tabs-list">
    <button id="tab-rooms" class="nav-tab-btn active" onclick="switchTab('rooms')">Rooms & Suites</button>
    <button id="tab-services" class="nav-tab-btn" onclick="switchTab('services')">Services & Amenities</button>
    <button id="tab-reservations" class="nav-tab-btn" onclick="switchTab('reservations')">My Bookings</button>
    <button id="tab-guests" class="nav-tab-btn" onclick="switchTab('guests')">Guests Directory</button>
</div>

<!-- Zawartość główna -->
<div class="card-hotel mb-5" style="padding:2rem">
    <!-- Dashboard dla obsługi -->
    <div id="section-dashboard" class="content-section d-none">
        <div class="section-hdr">
            <h3>Operations Control Panel</h3>
        </div>
        
        <!-- Statystyki -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card-hotel" style="background:var(--bg-warm);border-color:var(--border);padding:1.25rem">
                    <div style="font-size:0.75rem;font-weight:600;text-transform:uppercase;color:var(--text-muted)">Hotel Occupancy</div>
                    <div style="font-size:1.8rem;font-family:var(--serif);color:var(--accent);margin:0.25rem 0" id="stats-occupancy">0%</div>
                    <div style="font-size:0.72rem;color:var(--text-light)" id="stats-occupancy-detail">0 of 0 rooms filled</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card-hotel" style="background:var(--bg-warm);border-color:var(--border);padding:1.25rem">
                    <div style="font-size:0.75rem;font-weight:600;text-transform:uppercase;color:var(--text-muted)">Active Bookings</div>
                    <div style="font-size:1.8rem;font-family:var(--serif);color:var(--gold);margin:0.25rem 0" id="stats-bookings">0</div>
                    <div style="font-size:0.72rem;color:var(--text-light)">Total confirmed bookings</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card-hotel" style="background:var(--bg-warm);border-color:var(--border);padding:1.25rem">
                    <div style="font-size:0.75rem;font-weight:600;text-transform:uppercase;color:var(--text-muted)">Registered Guests</div>
                    <div style="font-size:1.8rem;font-family:var(--serif);color:var(--text);margin:0.25rem 0" id="stats-guests">0</div>
                    <div style="font-size:0.72rem;color:var(--text-light)">Total guest profiles</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card-hotel" style="background:var(--bg-warm);border-color:var(--border);padding:1.25rem">
                    <div style="font-size:0.75rem;font-weight:600;text-transform:uppercase;color:var(--text-muted)">Projected Income</div>
                    <div style="font-size:1.8rem;font-family:var(--serif);color:var(--gold-dark);margin:0.25rem 0" id="stats-revenue">$0.00</div>
                    <div style="font-size:0.72rem;color:var(--text-light)">Total revenue in system</div>
                </div>
            </div>
        </div>

        <!-- Tabele z aktywnościami -->
        <div class="row g-4">
            <div class="col-md-7">
                <div class="card-hotel h-100" style="padding:1.25rem">
                    <h5 style="font-family:var(--serif);margin-bottom:1rem;color:var(--gold)">Recent Reservations</h5>
                    <div class="table-responsive" id="dashboard-recent-bookings">
                        <p class="text-muted small">No recent bookings</p>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card-hotel h-100" style="padding:1.25rem">
                    <h5 style="font-family:var(--serif);margin-bottom:1rem;color:var(--gold)">System Overview</h5>
                    <p style="font-size:0.85rem;line-height:2">
                        <strong>Environment:</strong> <span class="role-pill">Development</span><br>
                        <strong>Secure Keys:</strong> <span class="role-pill">RSA-2048 / SHA-256</span><br>
                        <strong>Access Mode:</strong> <span id="stats-access-role" class="role-pill">Staff Only</span>
                    </p>
                    <hr style="border-color:var(--border-light)">
                    <button class="btn-gold w-100" onclick="showAddReservationModal()">Create Booking for Guest</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista gości -->
    <div id="section-guests" class="content-section d-none">
        <div class="section-hdr">
            <h3>Guest Directory</h3>
            <button class="btn-gold" id="btn-add-guest" onclick="showAddGuestModal()">+ New Guest</button>
        </div>
        <div id="guests-list" class="table-responsive">
            <p class="loading-pulse">Loading guests…</p>
        </div>
    </div>

    <!-- Lista pokoi -->
    <div id="section-rooms" class="content-section">
        <div class="section-hdr">
            <h3>Rooms & Suites</h3>
            <div style="display:flex;gap:.5rem;align-items:center">
                <button class="btn-outline" onclick="loadRooms(true)">Available Only</button>
                <button class="btn-outline" onclick="loadRooms(false)">All Rooms</button>
                <button class="btn-gold" id="btn-add-room" onclick="showAddRoomModal()">+ New Room</button>
            </div>
        </div>
        <div id="rooms-list" class="room-card-grid">
            <p class="loading-pulse">Loading rooms…</p>
        </div>
    </div>

    <!-- Lista usług -->
    <div id="section-services" class="content-section d-none">
        <div class="section-hdr">
            <h3>Services & Amenities</h3>
            <button class="btn-gold" id="btn-add-service" onclick="showAddServiceModal()">+ New Service</button>
        </div>
        <div id="services-list" class="service-card-grid">
            <p class="loading-pulse">Loading services…</p>
        </div>
    </div>

    <!-- Moje Rezerwacje -->
    <div id="section-reservations" class="content-section d-none">
        <div class="section-hdr">
            <h3>My Bookings</h3>
            <button class="btn-gold" id="btn-add-reservation" onclick="showAddReservationModal()">+ New Booking</button>
        </div>
        <div id="reservations-list" class="table-responsive">
            <p class="loading-pulse">Loading reservations…</p>
        </div>
    </div>
</div>

<!-- Modale ukryte na stronie -->

<!-- Szczegóły pokoju -->
<div class="modal fade" id="roomDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Room Details</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body"><div id="roomDetailsContent">Loading…</div></div>
    </div></div>
</div>

<!-- Szczegóły usługi -->
<div class="modal fade" id="serviceDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Service Details</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body"><div id="serviceDetailsContent">Loading…</div></div>
    </div></div>
</div>

<!-- Szczegóły rezerwacji -->
<div class="modal fade" id="reservationDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Reservation Details</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body"><div id="reservationDetailsContent">Loading…</div></div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Close</button>
        </div>
    </div></div>
</div>

<!-- Dodawanie gościa -->
<div class="modal fade" id="addGuestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">New Guest</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <form id="addGuestForm">
                <div class="mb-3"><label class="form-label">First Name</label><input type="text" class="form-control" name="firstName" required></div>
                <div class="mb-3"><label class="form-label">Last Name</label><input type="text" class="form-control" name="lastName" required></div>
                <div class="mb-3"><label class="form-label">Email</label><input type="email" class="form-control" name="email" required></div>
                <div class="mb-3"><label class="form-label">Phone</label><input type="text" class="form-control" name="phone"></div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gold" onclick="createGuest()">Save Guest</button>
        </div>
    </div></div>
</div>

<!-- Nowa rezerwacja -->
<div class="modal fade" id="addReservationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">New Booking</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <form id="addReservationForm">
                <div class="mb-3"><label class="form-label">Guest</label>
                    <select class="form-select" name="guestID" id="reservationGuestSelect" required><option value="">Select guest…</option></select>
                </div>
                <div class="mb-3"><label class="form-label">Room</label>
                    <select class="form-select" name="roomID" id="reservationRoomSelect" required><option value="">Select room…</option></select>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label class="form-label">Check-in</label><input type="date" class="form-control" name="checkInDate" required></div>
                    <div class="col-md-6 mb-3"><label class="form-label">Check-out</label><input type="date" class="form-control" name="checkOutDate" required></div>
                </div>
                <div class="mb-3"><label class="form-label">Number of Guests</label><input type="number" class="form-control" name="numberOfGuests" value="1" min="1" required></div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gold" onclick="createReservation()">Create Booking</button>
        </div>
    </div></div>
</div>

<!-- Dodawanie pokoju -->
<div class="modal fade" id="addRoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">New Room</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <form id="addRoomForm">
                <div class="mb-3"><label class="form-label">Room Number</label><input type="text" class="form-control" name="roomNumber" required></div>
                <div class="mb-3"><label class="form-label">Room Type</label><select class="form-select" name="roomTypeID" id="roomTypeSelect" required><option value="">Loading…</option></select></div>
                <div class="mb-3"><label class="form-label">Capacity</label><input type="number" class="form-control" name="capacity" min="1" value="2" required></div>
                <div class="mb-3"><label class="form-label">Price / Night</label><input type="number" class="form-control" name="pricePerNight" min="0" step="0.01" required></div>
                <div class="mb-3"><label class="form-label">Status</label><select class="form-select" name="status" required><option value="Available">Available</option><option value="Occupied">Occupied</option><option value="Maintenance">Maintenance</option></select></div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gold" onclick="createRoom()">Save Room</button>
        </div>
    </div></div>
</div>

<!-- Nowa usługa -->
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">New Service</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <form id="addServiceForm">
                <div class="mb-3"><label class="form-label">Service Name</label><input type="text" class="form-control" name="serviceName" required></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3"></textarea></div>
                <div class="mb-3"><label class="form-label">Unit Price</label><input type="number" class="form-control" name="unitPrice" min="0" step="0.01" required></div>
                <div class="mb-3"><label class="form-label">Availability</label><select class="form-select" name="availability" required><option value="Available">Available</option><option value="Unavailable">Unavailable</option></select></div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gold" onclick="createService()">Save Service</button>
        </div>
    </div></div>
</div>

<!-- Przypisywanie pokoju do rezerwacji -->
<div class="modal fade" id="addRoomToReservationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Assign Room</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="roomReservationId">
            <div class="mb-3"><label class="form-label">Available Room</label>
                <select class="form-select" id="roomSelect" required><option value="">Loading…</option></select>
                <div class="form-text">Only available rooms are listed</div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gold" onclick="submitAddRoom()">Assign Room</button>
        </div>
    </div></div>
</div>

<!-- Zamawianie usługi do rezerwacji -->
<div class="modal fade" id="addServiceToReservationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Add Service</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="serviceReservationId">
            <div class="mb-3">
                <label class="form-label">Service</label>
                <select class="form-select" id="serviceSelect"></select>
            </div>
            <div class="mb-3">
                <label class="form-label">Quantity</label>
                <input type="number" class="form-control" id="serviceQuantity" value="1" min="1">
            </div>
            <div class="mb-3">
                <label class="form-label">Date</label>
                <input type="date" class="form-control" id="serviceDate">
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gold" onclick="submitAddService()">Confirm</button>
        </div>
    </div></div>
</div>

<!-- Modal potwierdzenia akcji (Confirm Modal) -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header" style="border-bottom:none;padding-bottom:0">
            <h5 class="modal-title" id="confirmModalTitle" style="color:var(--gold);font-family:var(--serif)">Confirm</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <p id="confirmModalMessage" style="margin:0;color:var(--text-light)"></p>
        </div>
        <div class="modal-footer" style="border-top:none;padding-top:0">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-danger-sm" id="confirmModalOk" style="padding:0.4rem 1.2rem;font-size:0.9rem">OK</button>
        </div>
    </div></div>
</div>

@* Dodawanie skryptów JS *@
@section Scripts {
    <script src="~/js/api-client.js" asp-append-version="true"></script>
}
