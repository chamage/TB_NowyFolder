@page
@model IndexModel
@{
    ViewData["Title"] = "Reservation Management";
}

<!-- Hero -->
<div class="hero">
    <h1>Grand<em>Hotel</em></h1>
    <div class="divider"></div>
    <p>Reservation management dashboard — secure access with JWT authentication</p>
</div>

<!-- Auth -->
<div class="card-hotel auth-card">
    <div id="auth-logged-out-panel">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Username</label>
                <input type="text" class="form-control" id="auth-username" placeholder="Enter username">
            </div>
            <div class="col-md-3">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" id="auth-password" placeholder="Enter password">
            </div>
            <div class="col-md-2">
                <button class="btn-gold w-100" onclick="login()">Sign In</button>
            </div>
            <div class="col-md-4 text-md-end" style="display:flex;gap:.35rem;flex-wrap:wrap;justify-content:flex-end">
                <button class="demo-btn" onclick="fillDemoLogin('admin')">Admin</button>
                <button class="demo-btn" onclick="fillDemoLogin('reception')">Receptionist</button>
                <button class="demo-btn" onclick="fillDemoLogin('client')">Client</button>
            </div>
        </div>
    </div>

    <div class="d-none" id="auth-logged-in-panel">
        <div class="d-flex justify-content-between align-items-center flex-wrap" style="gap:.75rem">
            <div style="display:flex;align-items:center;gap:.75rem">
                <span class="user-pill" id="auth-username-display">—</span>
                <span class="role-pill" id="auth-role-display">—</span>
            </div>
            <button class="btn-danger-sm" onclick="logout()">Sign Out</button>
        </div>
    </div>

    <div class="mt-2" id="auth-message"></div>
</div>

<!-- Main -->
<div class="row" style="gap:0">
    <!-- Sidebar -->
    <div class="col-md-3 mb-3">
        <div class="card-hotel" style="padding:1rem">
            <div class="sidebar-nav">
                <button id="tab-guests" onclick="switchTab('guests')">
                    <span class="nav-icon">👥</span> Guests
                </button>
                <button id="tab-rooms" class="active" onclick="switchTab('rooms')">
                    <span class="nav-icon">🛏</span> Rooms
                </button>
                <button id="tab-services" onclick="switchTab('services')">
                    <span class="nav-icon">🍽</span> Services
                </button>
                <button id="tab-reservations" onclick="switchTab('reservations')">
                    <span class="nav-icon">📋</span> Reservations
                </button>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="col-md-9">
        <div class="card-hotel">

            <!-- Guests -->
            <div id="section-guests" class="content-section d-none">
                <div class="section-hdr">
                    <h3>Guest Directory</h3>
                    <button class="btn-gold" id="btn-add-guest" onclick="showAddGuestModal()">+ New Guest</button>
                </div>
                <div id="guests-list" class="table-responsive">
                    <p class="loading-pulse">Loading guests…</p>
                </div>
            </div>

            <!-- Rooms -->
            <div id="section-rooms" class="content-section">
                <div class="section-hdr">
                    <h3>Room Inventory</h3>
                    <button class="btn-gold" id="btn-add-room" onclick="showAddRoomModal()">+ New Room</button>
                </div>
                <div class="filter-row">
                    <button class="btn-outline" onclick="loadRooms(true)">Available Only</button>
                    <button class="btn-outline" onclick="loadRooms(false)">All Rooms</button>
                </div>
                <div id="rooms-list" class="table-responsive">
                    <p class="loading-pulse">Loading rooms…</p>
                </div>
            </div>

            <!-- Services -->
            <div id="section-services" class="content-section d-none">
                <div class="section-hdr">
                    <h3>Hotel Services</h3>
                    <button class="btn-gold" id="btn-add-service" onclick="showAddServiceModal()">+ New Service</button>
                </div>
                <div id="services-list" class="table-responsive">
                    <p class="loading-pulse">Loading services…</p>
                </div>
            </div>

            <!-- Reservations -->
            <div id="section-reservations" class="content-section d-none">
                <div class="section-hdr">
                    <h3>Reservations</h3>
                    <button class="btn-gold" id="btn-add-reservation" onclick="showAddReservationModal()">+ New Booking</button>
                </div>
                <div id="reservations-list" class="table-responsive">
                    <p class="loading-pulse">Loading reservations…</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══ Modals ══ -->

<!-- Room Details -->
<div class="modal fade" id="roomDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Room Details</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body"><div id="roomDetailsContent">Loading…</div></div>
    </div></div>
</div>

<!-- Service Details -->
<div class="modal fade" id="serviceDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Service Details</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body"><div id="serviceDetailsContent">Loading…</div></div>
    </div></div>
</div>

<!-- Reservation Details -->
<div class="modal fade" id="reservationDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Reservation Details</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body"><div id="reservationDetailsContent">Loading…</div></div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Close</button>
        </div>
    </div></div>
</div>

<!-- Add Guest -->
<div class="modal fade" id="addGuestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">New Guest</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <form id="addGuestForm">
                <div class="mb-3"><label class="form-label">First Name</label><input type="text" class="form-control" name="firstName" required></div>
                <div class="mb-3"><label class="form-label">Last Name</label><input type="text" class="form-control" name="lastName" required></div>
                <div class="mb-3"><label class="form-label">Email</label><input type="email" class="form-control" name="email" required></div>
                <div class="mb-3"><label class="form-label">Phone</label><input type="text" class="form-control" name="phone"></div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gold" onclick="createGuest()">Save Guest</button>
        </div>
    </div></div>
</div>

<!-- Add Reservation -->
<div class="modal fade" id="addReservationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">New Booking</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <form id="addReservationForm">
                <div class="mb-3"><label class="form-label">Guest</label>
                    <select class="form-select" name="guestID" id="reservationGuestSelect" required><option value="">Select guest…</option></select>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label class="form-label">Check-in</label><input type="date" class="form-control" name="checkInDate" required></div>
                    <div class="col-md-6 mb-3"><label class="form-label">Check-out</label><input type="date" class="form-control" name="checkOutDate" required></div>
                </div>
                <div class="mb-3"><label class="form-label">Number of Guests</label><input type="number" class="form-control" name="numberOfGuests" value="1" min="1" required></div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gold" onclick="createReservation()">Create Booking</button>
        </div>
    </div></div>
</div>

<!-- Add Room -->
<div class="modal fade" id="addRoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">New Room</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <form id="addRoomForm">
                <div class="mb-3"><label class="form-label">Room Number</label><input type="text" class="form-control" name="roomNumber" required></div>
                <div class="mb-3"><label class="form-label">Room Type</label><select class="form-select" name="roomTypeID" id="roomTypeSelect" required><option value="">Loading…</option></select></div>
                <div class="mb-3"><label class="form-label">Capacity</label><input type="number" class="form-control" name="capacity" min="1" value="2" required></div>
                <div class="mb-3"><label class="form-label">Price / Night</label><input type="number" class="form-control" name="pricePerNight" min="0" step="0.01" required></div>
                <div class="mb-3"><label class="form-label">Status</label><select class="form-select" name="status" required><option value="Available">Available</option><option value="Occupied">Occupied</option><option value="Maintenance">Maintenance</option></select></div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gold" onclick="createRoom()">Save Room</button>
        </div>
    </div></div>
</div>

<!-- Add Service -->
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">New Service</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <form id="addServiceForm">
                <div class="mb-3"><label class="form-label">Service Name</label><input type="text" class="form-control" name="serviceName" required></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3"></textarea></div>
                <div class="mb-3"><label class="form-label">Unit Price</label><input type="number" class="form-control" name="unitPrice" min="0" step="0.01" required></div>
                <div class="mb-3"><label class="form-label">Availability</label><select class="form-select" name="availability" required><option value="Available">Available</option><option value="Unavailable">Unavailable</option></select></div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gold" onclick="createService()">Save Service</button>
        </div>
    </div></div>
</div>

<!-- Add Room to Reservation -->
<div class="modal fade" id="addRoomToReservationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Assign Room</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="roomReservationId">
            <div class="mb-3"><label class="form-label">Available Room</label>
                <select class="form-select" id="roomSelect" required><option value="">Loading…</option></select>
                <div class="form-text">Only available rooms are listed</div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gold" onclick="submitAddRoom()">Assign Room</button>
        </div>
    </div></div>
</div>

<!-- Add Service to Reservation -->
<div class="modal fade" id="addServiceToReservationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Add Service</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="serviceReservationId">
            <div class="mb-3"><label class="form-label">Service</label><select class="form-select" id="serviceSelect" required><option value="">Loading…</option></select></div>
            <div class="mb-3"><label class="form-label">Quantity</label><input type="number" class="form-control" id="serviceQuantity" value="1" min="1" required></div>
            <div class="mb-3"><label class="form-label">Date</label><input type="date" class="form-control" id="serviceDate" required></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gold" onclick="submitAddService()">Add Service</button>
        </div>
    </div></div>
</div>

@section Scripts {
    <script src="~/js/api-client.js" asp-append-version="true"></script>
}
