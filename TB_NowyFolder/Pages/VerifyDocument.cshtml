@page
@{
    ViewData["Title"] = "Weryfikator dokumentów";
}

<div class="container mt-4" id="main-content" style="display: none;">
    <div class="text-center mb-4">
        <h2>Weryfikator dokumentów</h2>
        <p class="text-muted">Narzędzie do weryfikacji autentyczności i integralności generowanych rachunków oraz potwierdzeń rezerwacji.</p>
    </div>

    <div class="row">
        <!-- Sekcja generowania (symulacja systemu) -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Pobierz zabezpieczony dokument</h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted">System pobiera z bazy danych informacje o rezerwacji, tworzy reprezentację tekstową (JSON), oblicza hash SHA-256 i szyfruje go prywatnym kluczem serwera (RSA).</p>

                    <div class="mb-3">
                        <label class="form-label">ID rezerwacji:</label>
                        <input type="number" id="genReservationId" class="form-control" placeholder="Np. 1" value="1" />
                    </div>
                    <button class="btn btn-primary w-100" onclick="generateDocument()">Generuj dokument</button>

                    <div id="generatedResult" class="mt-4 d-none">
                        <h6>Wygenerowany dokument (skopiuj do weryfikacji):</h6>
                        <label class="form-label mt-2 mb-0 fw-bold small">Treść (payload):</label>
                        <textarea id="genPayload" class="form-control mb-2" rows="6" readonly></textarea>

                        <label class="form-label mb-0 fw-bold small">Otrzymana sygnatura (podpis RSA):</label>
                        <textarea id="genSignature" class="form-control" rows="3" readonly></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sekcja weryfikacji -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Sprawdź autentyczność</h5>
                </div>
                <div class="card-body">
                    <p class="small">Polega na wprowadzeniu treści rachunku oraz powiązanej z nim cyfrowej sygnatury. System zweryfikuje za pomocą klucza publicznego (RSA), czy treść zgadza się z podpisem i nie uległa zmianie.</p>

                    <div class="mb-3">
                        <label class="form-label fw-bold mb-0 small">Treść (payload):</label>
                        <textarea id="verifyPayload" class="form-control font-monospace" rows="6" placeholder="Wprowadź treść rachunku (JSON)"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold mb-0 small">Sygnatura:</label>
                        <textarea id="verifySignature" class="form-control font-monospace" rows="3" placeholder="Wprowadź ciąg znaków w Base64"></textarea>
                    </div>

                    <button class="btn btn-success w-100 shadow-sm" onclick="verifyDocument()">Wykonaj weryfikację</button>

                    <div id="verifyResult" class="mt-3 text-center fs-5 p-2 rounded d-none"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5 text-center" id="access-denied-content" style="display: none;">
    <h3 class="text-danger">Brak dostępu</h3>
    <p>Ten moduł jest przeznaczony wyłącznie dla administratorów.</p>
    <a href="/Index" class="btn btn-outline-primary mt-3">Powrót do strony głównej</a>
</div>

@section Scripts {
    <script>
        (function enforceAccessControl() {
            try {
                let authUser = JSON.parse(localStorage.getItem('authUser'));
                // W systemach weryfikacji token może mieć rolę zapisaną w tablicy lub wprost
                let hasAccess = false;
                if (authUser && authUser.role) {
                    if (Array.isArray(authUser.role)) {
                        hasAccess = authUser.role.includes('Administrator');
                    } else {
                        hasAccess = authUser.role === 'Administrator';
                    }
                }

                if (hasAccess) {
                    document.getElementById('main-content').style.display = 'block';
                } else {
                    document.getElementById('access-denied-content').style.display = 'block';
                }
            } catch {
                document.getElementById('access-denied-content').style.display = 'block';
            }
        })();

        function getAuthHeaders() {
            let token = localStorage.getItem('authToken');
            return {
                'Content-Type': 'application/json',
                'Authorization': token ? `Bearer ${token}` : ''
            };
        }

        async function generateDocument() {
            var id = document.getElementById("genReservationId").value;
            if(!id) return;

            try {
                let response = await fetch(`/api/documents/generate/${id}`, { headers: getAuthHeaders() });
                if (response.ok) {
                    let data = await response.json();
                    document.getElementById("genPayload").value = data.payload;
                    document.getElementById("genSignature").value = data.signature;
                    document.getElementById("generatedResult").classList.remove("d-none");
                } else if (response.status === 401 || response.status === 403) {
                    alert('Brak uprawnień. Zaloguj się jako administrator.');
                } else if(response.status === 404) {
                    alert('Nie znaleziono rezerwacji o podanym ID.');
                } else {
                    alert('Wystąpił błąd podczas generowania dokumentu.');
                }
            } catch (e) {
                console.error(e);
                alert("Błąd połączenia z serwerem.");
            }
        }

        async function verifyDocument() {
            var payload = document.getElementById("verifyPayload").value;
            var signature = document.getElementById("verifySignature").value;

            if(!payload || !signature) {
                alert('Proszę wypełnić oba pola.');
                return;
            }

            try {
                let response = await fetch(`/api/documents/verify`, {
                    method: 'POST',
                    headers: getAuthHeaders(),
                    body: JSON.stringify({ payload: payload, signature: signature })
                });

                let resultBox = document.getElementById("verifyResult");
                resultBox.classList.remove("d-none", "bg-success", "bg-danger", "text-white");

                if (response.ok) {
                    let data = await response.json();
                    if (data.isValid) {
                        resultBox.textContent = "Plik autentyczny i nienaruszony.";
                        resultBox.classList.add("bg-success", "text-white");
                    } else {
                        resultBox.textContent = "Sygnatura nie pasuje do treści dokumentu.";
                        resultBox.classList.add("bg-danger", "text-white");
                    }
                } else if (response.status === 401 || response.status === 403) {
                    alert('Brak uprawnień. Zaloguj się jako administrator.');
                } else {
                    alert('Wystąpił błąd weryfikacji po stronie serwera.');
                }
            } catch (e) {
                console.error(e);
                alert("Błąd połączenia z serwerem.");
            }
        }
    </script>
}
